<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Đổi Data Source nếu tên Instance SQL Server của máy bạn khác .\SQLEXPRESS -->
        <add name="QLKhachSanDb"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QLKhachSan;Integrated Security=True;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
